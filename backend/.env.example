# ============================================
# Student DevOps Hub — backend configuration
# Copy to .env (never commit .env) and fill in
# the values from your Supabase project settings.
# ============================================

# Runtime queries go through the Supabase session pooler (modern apps):
# Project Settings → Database → Connection string → URI  (enable pooling)
DATABASE_URL="postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Prisma migrations run directly against the database (no pooling):
# Project Settings → Database → Connection string → URI  (disable pooling)
DIRECT_URL="postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Auth:
# SUPABASE_URL / SUPABASE_ANON_KEY → Project Settings → API (anon "public" key)
# SUPABASE_SERVICE_KEY             → Project Settings → API (service_role key, secret)
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY="anon-public-key"
SUPABASE_SERVICE_KEY="service-role-key"

# Server
PORT=3000
NODE_ENV=development

# Frontend origin allowed by CORS (derived reset-password links use it too)
CLIENT_URL="http://localhost:5173"
